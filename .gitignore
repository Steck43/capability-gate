# live policy — never committed
allowlist.yaml

# runtime artifacts (logs live under ~/.hermes/logs/)
logs/
*.jsonl

# internal working docs
_internal/
.cursor/

# one-shot harness probes
_tmp_*
_tmp_lab_out_head/
harness/s1-in-grant/
harness/s1-off-grant/

# detached sibling pins used by scripts/run_full_suite.py
.tmp/

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
dist/

# os / editor
.DS_Store
.idea/
.vscode/

# Point-in-time backups of the live allowlist. Never track: this repo is
# public, and one "git add -A" would publish operational snapshots.
# Scanned 2026-08-17, no credentials present - policy, not incident.
allowlist.yaml.bak-*
*.bak-2[0-9][0-9][0-9]*

# Per-folder token the gate writes beside its decision log
.capability-gate-folder

# Lock, witness and anchor files the gate writes beside any decision log
*.jsonl.lock
*.jsonl.witness
*.jsonl.anchor

# demo output (make demo-all)
out/
